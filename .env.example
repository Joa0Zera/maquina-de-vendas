# PostgreSQL
DATABASE_URL=postgresql://maquina:maquina@localhost:5432/maquina_de_vendas

# Redis
REDIS_URL=redis://localhost:6379

# Better Auth (Next.js)
BETTER_AUTH_SECRET=change-me-use-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cakto webhook
CAKTO_WEBHOOK_SECRET=your-cakto-webhook-secret

# Cakto legacy/test integration (apps/web/src/lib/providers/cakto)
# Not used by the main checkout flow — that reads per-organization
# credentials from the integration_settings table instead. These are
# only needed for /api/integrations/cakto/test and /products routes.
CAKTO_CLIENT_ID=your-cakto-client-id
CAKTO_CLIENT_SECRET=your-cakto-client-secret
CAKTO_BASE_URL=https://api.cakto.com.br

# API (Hono — módulos legados)
API_PORT=3001
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Google Gemini (geração de conteúdo IA)
GEMINI_API_KEY=your-gemini-api-key

# Reddit API (Trend Engine — opcional, só necessário para descoberta de tendências)
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret
REDDIT_USER_AGENT=maquina-de-vendas/1.0
